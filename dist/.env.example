# ============================================================
# ticket_sync 환경 변수 예시 파일
# 이 파일을 복사해서 ".env" 로 저장한 뒤 실제 값으로 채우세요.
# .env 파일은 절대 git 등 버전관리에 커밋하지 마세요.
# ============================================================

# ---- Microsoft Services Hub / Engage Center 로그인 ----
# MFA가 걸려있는 계정이라면 PASSWORD 없이 최초 1회 수동 로그인 후
# Playwright persistent context(브라우저 프로필)에 세션이 저장됩니다.
# 아이디만 자동입력에 사용하고, 비밀번호/인증은 사람이 직접 처리하는 것을 권장합니다.
MS_USERNAME=yr.choi@kt.com
MS_PASSWORD=

# Playwright가 로그인 세션(쿠키 등)을 저장할 로컬 프로필 폴더
MS_BROWSER_PROFILE_DIR=./data/browser_profile

# Engage Center 접속 URL (실제 접속 URL로 교체)
MS_LOGIN_URL=https://engage.microsoft.com/
MS_CASE_MANAGEMENT_URL=https://engage.microsoft.com/Support/CaseManagement

# ---- Freshdesk: 운영(prod) ----
FRESHDESK_PROD_DOMAIN=company.freshdesk.com
FRESHDESK_PROD_API_KEY=

# ---- Freshdesk: 테스트(test) ----
FRESHDESK_TEST_DOMAIN=company-test.freshdesk.com
FRESHDESK_TEST_API_KEY=
